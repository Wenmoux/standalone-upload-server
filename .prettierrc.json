{
    "printWidth": 140,
    "tabWidth": 4,
    "semi": true,
    "trailingComma": "none",
    "overrides": [
        {
            "files": ["cirno-src/src/**/*.js"],
            "options": {
                "tabWidth": 2,
                "semi": false,
                "singleQuote": true
            }
        },
        {
            "files": ["admin-ui/src/**/*.css", "ui/**/*.css"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": [".github/workflows/ci.yml"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
