# Same shape as .env.example; kept as an explicit Docker template.
POSTGRES_DB=po18
POSTGRES_USER=po18
POSTGRES_PASSWORD=change-this-postgres-password
PO18_PG_URL=postgres://po18:change-this-postgres-password@postgres:5432/po18

PO18_UPLOAD_ADMIN_USER=admin
PO18_UPLOAD_ADMIN_PASSWORD=change-this-admin-password
PO18_UPLOAD_SESSION_SECRET=change-this-long-random-secret
PO18_CREDENTIAL_ENCRYPTION_KEY=
PO18_CREDENTIAL_ENCRYPTION_KEYS=
PO18_CORS_ORIGINS=
PO18_TRUST_PROXY=1
PO18_CSRF_ALLOW_MISSING_ORIGIN=0
PO18_SETUP_COOKIE_SECURE=0
PO18_SETUP_AUTH_RATE_MAX=20
PO18_SETUP_AUTH_RATE_WINDOW_MS=900000
PO18_TTS_PROXY_ALLOWED_HOSTS=
PO18_TTS_PROXY_MAX_RESPONSE_BYTES=10485760
PO18_AUTH_RATE_MAX=20
PO18_PUBLIC_LOOKUP_RATE_MAX=120
PO18_TTS_RATE_MAX=30
PO18_UPLOAD_RATE_MAX=600
PO18_UPLOAD_API_TOKEN=change-this-random-upload-api-token
PO18_UPLOAD_API_ALLOWED_IPS=
PO18_BOT_API_TOKEN=change-this-random-bot-api-token
PO18_BOT_API_SCOPES=bot:read,bot:user,bot:export,bot:po18
PO18_BOT_API_ALLOWED_IPS=
PO18_METRICS_TOKEN=
PO18_CHILD_RESTART_BASE_MS=1000
PO18_CHILD_RESTART_MAX_MS=30000
PO18_CHILD_RESTART_STABLE_MS=120000
PO18_CHILD_RESTART_LIMIT=10
PO18_CHILD_STOP_TIMEOUT_MS=10000
PO18_CRAWLER_CIRCUIT_FAILURES=5
PO18_CRAWLER_CIRCUIT_COOLDOWN_MS=60000

TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_REQUEST_TIMEOUT_MS=60000

PO18_SHARE_API_URL=http://127.0.0.1:3200
PIKPAK_WEBDAV_URL=
PIKPAK_WEBDAV_USERNAME=
PIKPAK_WEBDAV_PASSWORD=
PIKPAK_WEBDAV_ROOT=/
# Optional: AES-256-GCM encryption for remote backup uploads.
PO18_BACKUP_ENCRYPTION_KEY=
PO18_REMOTE_BACKUP_KEEP=8
